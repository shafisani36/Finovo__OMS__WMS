APP_NAME="Finovo OMS / WMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
# Public HTTPS address stores send order/product notifications to (defaults to APP_URL).
# For local testing use a tunnel address, e.g. https://xxxx.trycloudflare.com
WEBHOOK_BASE_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# One log file per day, kept for 14 days (LOG_DAILY_DAYS)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# Database Connection (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finovo_oms_wms
DB_USERNAME=finovo_user
DB_PASSWORD=your_secure_db_password
# Read replicas, comma-separated (optional, for high traffic); empty = everything on DB_HOST
DB_READ_HOSTS=
# Database clock in UTC like the app, whatever the database server's own time zone
DB_TIMEZONE=+00:00

# First-Party SPA & Session Settings
FRONTEND_URL=https://app.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=app.yourdomain.com
# API token lifetime in minutes (7 days); signed-in requests per user per minute
SANCTUM_EXPIRATION=10080
API_RATE_LIMIT=300
# Refuse store, courier and image addresses inside a private network
BLOCK_PRIVATE_HOSTS=true
# Redis keeps sessions, cache, rate limits and queued work in memory; the database
# drivers work too, but every request then writes to MySQL (fine for one small server).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache and Queues (emails, store updates and webhooks run on the queue worker)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Behind a load balancer or Cloudflare: its addresses (or *), so rate limits see the real visitor address
TRUSTED_PROXIES=

# Mail Delivery (SMTP / Resend / Postmark / SES)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS="security@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Store Platforms (Stores → Connect New Store)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=
BIGCOMMERCE_APP_ID=

EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_RUNAME=
EBAY_ENV=sandbox

WIX_APP_ID=
WIX_APP_SECRET=
WIX_SHARE_URL_ID=
WIX_API_KEY=
# Public key from the Wix app dashboard (Webhooks); the app's webhooks call {WEBHOOK_BASE_URL}/api/v1/webhooks/wix
WIX_WEBHOOK_PUBLIC_KEY=

# OpenCart / osCommerce shop databases (default login; each store can override)
DB_EXTERNAL_HOST=127.0.0.1
DB_EXTERNAL_PORT=3306
DB_EXTERNAL_USER=root
DB_EXTERNAL_PASSWORD=

# Read-only AI assistant (OpenRouter); leave the key empty to keep it off
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Single sign-on (login page buttons). Redirect URI to register at the provider:
#   {APP_URL}/api/v1/auth/sso/microsoft/callback  and  {APP_URL}/api/v1/auth/sso/oidc/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL="Enterprise SSO"
