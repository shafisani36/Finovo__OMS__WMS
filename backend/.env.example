APP_NAME="Finovo OMS / WMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Connection (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finovo_oms_wms
DB_USERNAME=finovo_user
DB_PASSWORD=your_secure_db_password

# First-Party SPA & Session Settings
FRONTEND_URL=https://app.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=app.yourdomain.com
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache and Queues
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail Delivery (SMTP / Resend / Postmark / SES)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS="security@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Store Platforms (Stores → Connect New Store)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=
BIGCOMMERCE_APP_ID=

EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_RUNAME=
EBAY_ENV=sandbox

WIX_APP_ID=
WIX_APP_SECRET=
WIX_SHARE_URL_ID=
WIX_API_KEY=

# OpenCart / osCommerce shop databases (default login; each store can override)
DB_EXTERNAL_HOST=127.0.0.1
DB_EXTERNAL_PORT=3306
DB_EXTERNAL_USER=root
DB_EXTERNAL_PASSWORD=
